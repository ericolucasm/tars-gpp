# Banco Postgres (Neon pela integração da Vercel, ou qualquer Postgres)
DATABASE_URL=postgresql://tars:tars@localhost:5432/tars
# Opcional: conexão direta para migrações (a integração Neon cria DATABASE_URL_UNPOOLED)
# DATABASE_URL_UNPOOLED=

# Login com Google (Better Auth)
BETTER_AUTH_SECRET=            # chave aleatória longa (ex.: openssl rand -base64 32)
BETTER_AUTH_URL=http://localhost:3000   # URL pública do app (em produção: https://seu-dominio)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# "dev" = login sem senha escolhendo uma pessoa da demo (SÓ local). Sem esta variável: login com Google.
AUTH_MODE=dev

# Opcional: fixa a data de "hoje" (AAAA-MM-DD) para demos e testes
# TARS_HOJE=2026-10-17

# Na primeira migração com banco vazio, carrega a empresa demo "Acme"
SEED_DEMO=true

# Seu acesso em produção: esta pessoa vira PMO + Admin no deploy (entre com a conta Google deste e-mail)
# TARS_ADMIN_EMAIL=voce@gmail.com
# TARS_ADMIN_NOME=Seu Nome
