# Banco (Supabase > Project Settings > Database > Connection string).
# Em produção use a string do pooler (porta 6543). Aceita também POSTGRES_URL (integração Vercel + Supabase).
DATABASE_URL=postgresql://tars:tars@localhost:5432/tars

# Supabase Auth (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# "supabase" (produção) ou "dev" (login sem senha escolhendo uma pessoa do seed — NUNCA em produção)
AUTH_MODE=dev

# Opcional: fixa a data de "hoje" (AAAA-MM-DD) para demos e testes
# TARS_HOJE=2026-10-17

# Na primeira migração com banco vazio, carrega a empresa demo "Acme"
SEED_DEMO=true

# Seu acesso real em produção: esta pessoa vira PMO + Admin no deploy
# (crie o mesmo e-mail em Supabase > Authentication > Users)
# TARS_ADMIN_EMAIL=voce@empresa.com.br
# TARS_ADMIN_NOME=Seu Nome

# URL pública do app (para links de convite). Na Vercel é detectada sozinha.
# NEXT_PUBLIC_SITE_URL=https://tars-gpp.vercel.app
